    "node-cron": "3.0.3",
    "pino": "9.6.0"
  },
  "devDependencies": {
    "@types/node": "20.17.12",
    "@types/node-cron": "3.0.11",
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "eslint": "9.17.0",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "prettier": "3.4.2",
    "ts-node": "10.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
